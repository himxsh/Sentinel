BEDROCK_REGION=us-east-1
BEDROCK_LLM_MODEL=qwen.qwen3-coder-next
# CCLOUD_BIN=ccloud
REMEDIATE_MODE=local
# REMEDIATE_LAMBDA_URL=https://...
# AGENT_URL=http://localhost:8000
