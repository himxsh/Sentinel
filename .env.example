DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
SENTINEL_READ_USER=sentinel_read
SENTINEL_READ_PASSWORD=<generate-a-secure-password>
EMBEDDINGS_BACKEND=fake
LLM_BACKEND=fake
AWS_REGION=us-east-1
S3_BUCKET=sentinel-artifacts-951532862171-us-east-1
# Set LLM_BACKEND=bedrock for live Qwen3 Coder 480B; embeddings stay fake until Titan unlocks.
# 480B is not in the us-east-1 catalog; Converse must use us-west-2.
BEDROCK_REGION=us-west-2
BEDROCK_LLM_MODEL=qwen.qwen3-coder-480b-a35b-v1:0
# CCLOUD_BIN=ccloud
REMEDIATE_MODE=local
# REMEDIATE_LAMBDA_URL=https://...
# AGENT_URL=http://localhost:8000
# See infra/aws_setup.md for Bedrock unlock + IAM
